<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Widgets open the app through migrainelog:// links (see WidgetBridge.swift).
	     The rest of the Info.plist is still generated (GENERATE_INFOPLIST_FILE = YES). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>white.tea.MigraineLog</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>migrainelog</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
